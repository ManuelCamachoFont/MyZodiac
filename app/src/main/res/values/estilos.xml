<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="TextoZodiac">
        <item name="android:textColor">@color/texto_claro</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
        <item name="android:shadowColor">@color/sombra_texto</item>
        <item name="android:shadowDx">2</item>
        <item name="android:shadowDy">2</item>
        <item name="android:shadowRadius">4</item>
    </style>

    <style name="TextoZodiac.Titulo">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/dorado</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="BotonZodiac" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/morado</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">18sp</item>
        <item name="android:minWidth">160dp</item>
    </style>
</resources>